  "obWelcomeTitle": "Welcome to\nDroplet",
  "obWelcomeSubtitle": "A messenger that works where there's no network left.",
  "obFeatOfflineTitle": "No internet, no carrier",
  "obFeatOfflineText": "Phones talk to each other directly, one hop at a time. No antenna, no bill.",
  "obFeatEncryptedTitle": "End-to-end encrypted",
  "obFeatEncryptedText": "Not even the phones relaying your messages can read them.",
  "obFeatLocalTitle": "Nothing leaves your device",
  "obFeatLocalText": "No account, no server, no data collection. Your conversations stay with you.",
  "obRelayTitle": "Hop by\nhop",
  "obRelaySubtitle": "Your message hops from phone to phone until it reaches its recipient, even if you're not within direct range.",
  "obFeatCrowdTitle": "The more of us, the farther it reaches",
  "obFeatCrowdText": "Every device in range grows the network for everyone.",
  "obFeatNothingLostTitle": "Nothing is lost",
  "obFeatNothingLostText": "A message meant for someone who's away waits, then moves on as soon as a path opens.",
  "obSafetyTitle": "Find each other,\nwithout a network",
  "obSafetySubtitle": "When nothing else works, knowing where others are and that they're okay becomes the most useful information there is.",
  "obFeatMapTitle": "A map that works offline",
  "obFeatMapText": "The areas you view stay on your phone. Once viewed, they display without internet.",
  "obFeatMeshPosTitle": "Locations come from the mesh",
  "obFeatMeshPosText": "No server: the location leaves your contact's phone encrypted and hops from device to device until it reaches yours.",
  "obFeatCheckinTitle": "“I'm safe,” in one tap",
  "obFeatCheckinText": "A single tap broadcasts your status to the whole neighborhood. You choose whether to include an approximate location, or not.",
  "obStatusTitle": "Sharing\nupdates",
  "obStatusSubtitle": "A photo, a word, a mood: your status travels from phone to phone, just like your messages.",
  "obFeatStatusMediaTitle": "Photo, video, or text",
  "obFeatStatusMediaText": "Post whatever you want to show. People in range receive it, without going through the internet.",
  "obFeatStatusSeenTitle": "You see who's seen it",
  "obFeatStatusSeenText": "Everyone who opens your status lets you know in return, over the same path.",
  "obFeatStatusExpireTitle": "It disappears after a day",
  "obFeatStatusExpireText": "Twenty-four hours, then the status vanishes from every phone that received it.",
  "obRemovePhoto": "Remove the photo",
  "obChoosePhoto": "Choose a photo",
  "obPhotoTitle": "A face,\nif you like",
  "obPhotoSubtitle": "It helps others recognize you in a list. Nothing requires you to add one.",
  "obFeatPhotoLocalTitle": "It stays on this phone",
  "obFeatPhotoLocalText": "No server receives it, no online backup keeps it. It lives in the app's folder, and nowhere else.",
  "obFeatPhotoCompressTitle": "Shrunk before being stored",
  "obFeatPhotoCompressText": "Droplet only keeps a 320-pixel thumbnail. Your original photo is never copied.",
  "obNetworkTitle": "Droplet grows\nwith you",
  "obNetworkSubtitle": "Every person who installs it grows the network — for them, and for everyone around them.",
  "obSendToFriend": "Send Droplet to someone",
  "obFeatShareOfflineTitle": "Even sharing doesn't need the internet",
  "obFeatShareOfflineText": "Droplet sends you its own installer file. It travels over Bluetooth, Wi-Fi Direct, or a memory card — no connection needed, on either end.",
  "obFeatThreeTitle": "Three people are enough to start",
  "obFeatThreeText": "With two, you write to each other within sight. With a few in a neighborhood, messages relay and the range becomes far greater than any single phone.",
  "obIdentityTitle": "What should we\ncall you?",
  "obIdentitySubtitle": "This name will appear to people you cross paths with. You can choose one that doesn't identify you.",
