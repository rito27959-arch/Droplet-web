<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <!-- Requis pour acquérir le MulticastLock nécessaire à la découverte
         mDNS (NsdManager) du transport Wi-Fi local — sans elle, la
         découverte échoue silencieusement (NsdError/securityIssue). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <!-- Depuis Android 13, l'accès aux fichiers est découpé par TYPE de
         média : une seule permission « stockage » n'existe plus. Ces
         trois-là couvrent le choix d'une photo, d'une vidéo et d'une
         chanson pour accompagner un statut. Sans elles, le sélecteur
         s'ouvre mais revient vide sur les appareils récents. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <!-- `tools:replace` est obligatoire ici : le plugin caméra déclare
         la même permission avec `maxSdkVersion="28"`, et deux valeurs
         différentes pour un même attribut font échouer la fusion des
         manifestes. On impose la nôtre (29), qui couvre une version
         d'Android de plus. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:replace="android:maxSdkVersion"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Appel entrant en plein écran, même téléphone verrouillé. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- ══════════════════════════════════════════════════════════════
         LA NOTIFICATION D'APPEL SYSTÈME (pastille de la barre d'état)
         ══════════════════════════════════════════════════════════════
         La pastille avec le minuteur et le bouton « Raccrocher » dessiné
         par Android n'apparaissent QUE pour une notification `CallStyle`
         portée par un service de premier plan de type `phoneCall`.

         ⚠️ CE TYPE A DEUX CONDITIONS, vérifiées par le système au
         démarrage du service :
           1. FOREGROUND_SERVICE_PHONE_CALL déclarée ;
           2. ET, au choix, MANAGE_OWN_CALLS déclarée OU être
              l'application téléphone par défaut.
         Droplet prend la première : MANAGE_OWN_CALLS est une permission
         de manifeste, sans fenêtre de demande, et c'est exactement ce
         pour quoi elle existe — une application qui gère ses PROPRES
         appels. Sans elle, le service est refusé et la pastille
         n'apparaît jamais. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL"/>
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true"/>
    <uses-feature android:name="android.hardware.wifi" android:required="false"/>
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false"/>

    <!-- LECTURE À VOIX HAUTE (flutter_tts). Depuis Android 11, une app
         doit déclarer qu'elle cherche le moteur de synthèse vocale :
         sans ce bloc, il lui est tout simplement invisible et « Lire »
         ne produit aucun son, sans la moindre erreur. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="Droplet"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Lien d'invitation : la page `…/i#…` de l'annuaire ouvre
                 `droplet://droplet/invite?d=…`, que le routeur de l'app reçoit
                 comme la route `/invite` (lien profond Flutter). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="droplet" android:host="droplet"/>
            </intent-filter>
            <!-- Cible de partage : Droplet apparaît dans « Partager vers… »
                 des autres apps Android, pour du texte comme n'importe quel
                 fichier (voir receive_sharing_intent + ShareTargetScreen). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>

        <!--
          LES POINTS D'ENTRÉE DE L'APPLICATION, un par icône.

          Android fige l'icône d'une app dans son manifeste, lu à
          l'installation : impossible de la remplacer à l'exécution. La
          seule méthode officielle consiste à déclarer plusieurs alias
          vers la MÊME activité, chacun avec sa propre icône, et à n'en
          laisser qu'un activé — c'est ce que fait `MainActivity.kt`.

          ⚠️ `LauncherDefault` est le seul avec `enabled="true"`. Si
          aucun ne l'était, l'application n'apparaîtrait nulle part et
          serait impossible à ouvrir.
        -->
        <activity-alias
            android:name=".LauncherDefault"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="Droplet"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherV1"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_v1"
            android:roundIcon="@mipmap/ic_launcher_v1_round"
            android:label="Droplet"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherV2"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_v2"
            android:roundIcon="@mipmap/ic_launcher_v2_round"
            android:label="Droplet"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherV3"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_v3"
            android:roundIcon="@mipmap/ic_launcher_v3_round"
            android:label="Droplet"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherV4"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_v4"
            android:roundIcon="@mipmap/ic_launcher_v4_round"
            android:label="Droplet"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherV5"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_v5"
            android:roundIcon="@mipmap/ic_launcher_v5_round"
            android:label="Droplet"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherV6"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_v6"
            android:roundIcon="@mipmap/ic_launcher_v6_round"
            android:label="Droplet"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherV7"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_v7"
            android:roundIcon="@mipmap/ic_launcher_v7_round"
            android:label="Droplet"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherV8"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_v8"
            android:roundIcon="@mipmap/ic_launcher_v8_round"
            android:label="Droplet"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherV9"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_v9"
            android:roundIcon="@mipmap/ic_launcher_v9_round"
            android:label="Droplet"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherV10"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_v10"
            android:roundIcon="@mipmap/ic_launcher_v10_round"
            android:label="Droplet"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherV11"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_v11"
            android:roundIcon="@mipmap/ic_launcher_v11_round"
            android:label="Droplet"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!--
          ⚠️ LES ALIAS V9, V10 ET V11 ÉTAIENT DÉCLARÉS DEUX FOIS (copiés-collés
          au-dessus de V12). Deux éléments de même nom font échouer la fusion
          des manifestes ; on n'en garde qu'un de chaque.
        -->

        <activity-alias
            android:name=".LauncherV12"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_v12"
            android:roundIcon="@mipmap/ic_launcher_v12_round"
            android:label="Droplet"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Le service qui tient l'appel en cours. `exported="false"` :
             seule l'application le démarre, jamais une autre. -->
        <service
            android:name=".AppelEnCoursService"
            android:foregroundServiceType="phoneCall"
            android:exported="false" />

        <!-- Le bouton « Raccrocher » de la notification. -->
        <receiver
            android:name=".AppelActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.droplet.droplet.APPEL_RACCROCHER"/>
            </intent-filter>
        </receiver>

        <!--
          ══════════════════════════════════════════════════════════
          LE WIDGET D'ÉCRAN D'ACCUEIL
          ══════════════════════════════════════════════════════════
          `exported="false"` : seul le système a besoin de le
          déclencher. L'exporter permettrait à n'importe quelle
          application installée de lui envoyer des intentions.
        -->
        <receiver
            android:name=".WidgetDroplet"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_droplet_info"/>
        </receiver>

        <!-- ══ LES CONVERSATIONS ANDROID ════════════════════════════ -->
        <!--
          LA FENÊTRE DE LA BULLE. Elle affiche une conversation PAR-DESSUS
          l'application en cours, et c'est ce qui dicte ses trois attributs
          inhabituels :

            • `allowEmbedded` — Android l'affiche dans SA fenêtre à lui, pas
              dans la nôtre. Sans cet attribut, la bulle s'ouvre vide.
            • `resizeableActivity` — on déplace et on redimensionne une
              bulle à la main. Une activité non redimensionnable est tout
              simplement refusée comme bulle.
            • `documentLaunchMode="always"` — chaque conversation est une
              tâche séparée. Sans lui, Android réutilise l'activité et la
              bulle reste collée à la conversation précédente, quelle que
              soit celle qu'on touche.

          `exported="false"` : seul le système la lance, par le
          `PendingIntent` des métadonnées de bulle. L'exporter permettrait à
          n'importe quelle application d'ouvrir une conversation.
        -->
        <activity
            android:name=".BulleActivity"
            android:exported="false"
            android:allowEmbedded="true"
            android:resizeableActivity="true"
            android:documentLaunchMode="always"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
        </activity>

        <!--
          LA RÉPONSE TAPÉE DEPUIS LE VOLET DE NOTIFICATIONS.

          `exported="false"` : seul le système le déclenche, par le
          `PendingIntent` de l'action de réponse. Exporté, n'importe quelle
          application installée pourrait lui faire envoyer un message en
          votre nom.
        -->
        <receiver
            android:name=".ReponseDirecteReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.droplet.droplet.REPONSE_DIRECTE"/>
                <!-- « Marquer comme lu » et la réaction en un geste, depuis
                     le volet. Mêmes règles : jamais exporté, intention
                     explicite seulement. -->
                <action android:name="com.droplet.droplet.MARQUER_LU"/>
                <action android:name="com.droplet.droplet.REAGIR"/>
            </intent-filter>
        </receiver>

        <!-- Accélération GPU pour l'assistant IA local (flutter_gemma / -->
        <!-- MediaPipe). Sans effet si l'appareil n'a pas ces bibliothèques : -->
        <!-- `required="false"` fait retomber le paquet sur le CPU. -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false"/>
        <uses-native-library
            android:name="libOpenCL-car.so"
            android:required="false"/>
        <uses-native-library
            android:name="libOpenCL-pixel.so"
            android:required="false"/>

    </application>
</manifest>
