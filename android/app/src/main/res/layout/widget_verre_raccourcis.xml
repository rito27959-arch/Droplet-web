<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Droplet au style Glasmio (voir WidgetsVerre.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/verre_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/verre_fond"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="10dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/verre_b_nouveau"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/verre_bouton"
                android:padding="14dp"
                android:src="@drawable/verre_ic_nouveau"
                android:contentDescription="@string/verre_nouveau" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/verre_nouveau"
                android:textColor="@color/verre_texte"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/verre_b_reseau"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/verre_bouton"
                android:padding="14dp"
                android:src="@drawable/verre_ic_reseau"
                android:contentDescription="@string/verre_reseau" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/verre_reseau"
                android:textColor="@color/verre_texte"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/verre_b_carte"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/verre_bouton"
                android:padding="14dp"
                android:src="@drawable/verre_ic_carte"
                android:contentDescription="@string/verre_carte" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/verre_carte"
                android:textColor="@color/verre_texte"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/verre_b_urgence"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/verre_rond_rouge"
                android:padding="14dp"
                android:src="@drawable/verre_ic_urgence"
                android:contentDescription="@string/verre_urgence" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/verre_urgence"
                android:textColor="@color/verre_texte"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
