<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Droplet au style Glasmio (voir WidgetsVerre.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/verre_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/verre_fond"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/verre_rond_accent"
                android:padding="6dp"
                android:src="@drawable/verre_ic_droplet"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Droplet"
                android:textColor="@color/verre_texte"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/verre_nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:includeFontPadding="false"
            android:text="0"
            android:textColor="@color/verre_texte"
            android:textSize="40sp"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:id="@+id/verre_libelle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/verre_aucun"
            android:textColor="@color/verre_texte_doux"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/verre_point"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/verre_point_gris"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/verre_portee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/verre_personne"
                android:textColor="@color/verre_texte_doux"
                android:textSize="12sp" />
        </LinearLayout>
</LinearLayout>
