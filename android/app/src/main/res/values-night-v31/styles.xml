<?xml version="1.0" encoding="utf-8"?>
<!-- Même écran de démarrage, en mode sombre : seul le fond change, pour
     rejoindre le noir de l'app plutôt que de l'éclairer une seconde.
     Le parent reste `NoTitleBar`, pour la raison expliquée dans le
     fichier `values-v31/styles.xml`. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/lancement_fond</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/marque_lancement</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
