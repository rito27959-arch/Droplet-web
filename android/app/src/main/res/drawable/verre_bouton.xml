<?xml version="1.0" encoding="utf-8"?>
<!-- Un bouton rond de verre, comme les boutons de Glasmio. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/verre_bouton" />
            <stroke android:width="1dp" android:color="@color/verre_bouton_lisere" />
        </shape>
    </item>
    <item android:bottom="22dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="@color/verre_reflet" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
